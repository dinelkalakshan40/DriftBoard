<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.driftboard.app">

    <!-- Permissions for Camera, Gallery, and Online Sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_driftboard_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_driftboard_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriftBoard"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- FileProvider for secure URI sharing with Camera and Sharesheet -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DriftBoard.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Create Post -->
        <activity
            android:name=".activities.CreatePostActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Edit Post -->
        <activity
            android:name=".activities.EditPostActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Post Detail -->
        <activity
            android:name=".activities.PostDetailActivity"
            android:exported="false" />

        <!-- Search Posts -->
        <activity
            android:name=".activities.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible" />

        <!-- Multi-select Batch Delete -->
        <activity
            android:name=".activities.MultiDeleteActivity"
            android:exported="false" />

        <!-- Upload Queue (WordPress & Blogger) -->
        <activity
            android:name=".activities.UploadQueueActivity"
            android:exported="false" />

        <!-- Profile & Account Screen -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false" />

        <!-- View All Posts -->
        <activity
            android:name=".activities.ViewPostsActivity"
            android:exported="false" />

    </application>

</manifest>
